          "type": "button",
          "text": "How is the regeneration window doing?",
          "help": "Open or closed, the in-game hours left, and how many people it has given a body.",
          "action": {
            "type": "CallGlobalFunction",
            "script": "Silhouette:Player",
            "function": "RegenerationStatus",
            "params": []
          }
        },
        {
          "type": "button",
          "text": "Open a new 24-hour regeneration window",
