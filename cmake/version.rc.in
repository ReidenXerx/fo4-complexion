#include <winres.h>

1 VERSIONINFO
	FILEVERSION @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
	PRODUCTVERSION @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
	FILEFLAGSMASK 0x17L
	FILEFLAGS 0x0L
	FILEOS 0x4L
	FILETYPE 0x2L
	FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "Complexion - F4SE plugin for Fallout 4"
			VALUE "FileVersion", "@PROJECT_VERSION@.0"
			VALUE "InternalName", "Complexion"
			VALUE "OriginalFilename", "Complexion.dll"
			VALUE "ProductName", "Complexion"
			VALUE "ProductVersion", "@PROJECT_VERSION@.0"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
